{
	"name": "@wsuwp/hrscourses",
	"version": "2.3.1-rc.1",
	"description": "A plugin to create a Course custom post type for WSU Human Resource Services.",
	"author": "washingtonstateuniversity",
	"contributors": [
		{
			"name": "Adam Turner"
		}
	],
	"license": "GPL-2.0-or-later",
	"keywords": [
		"wordpress",
		"plugin",
		"custom-post-type",
		"learning"
	],
	"homepage": "https://github.com/washingtonstateuniversity/wsuwp-plugin-hrs-courses/blob/stable/README.md",
	"repository": {
		"type": "git",
		"url": "https://github.com/washingtonstateuniversity/wsuwp-plugin-hrs-courses"
	},
	"bugs": {
		"url": "https://github.com/washingtonstateuniversity/wsuwp-plugin-hrs-courses/issues"
	},
	"engines": {
		"node": ">=20.10.0",
		"npm": ">=10.2.3"
	},
	"browserslist": [
		"> 1%",
		"ie 8-11",
		"Firefox ESR"
	],
	"devDependencies": {
		"@babel/core": "^7.24.4",
		"@babel/runtime": "^7.24.4",
		"@wordpress/babel-preset-default": "^7.39.0",
		"@wordpress/dependency-extraction-webpack-plugin": "^5.6.0",
		"@wordpress/eslint-plugin": "^17.12.0",
		"@wordpress/icons": "^9.46.0",
		"@wordpress/npm-package-json-lint-config": "^4.40.0",
		"@wordpress/stylelint-config": "^21.38.0",
		"babel-loader": "^9.1.3",
		"classnames": "^2.5.1",
		"copy-webpack-plugin": "^12.0.2",
		"cssnano": "^6.1.2",
		"eslint": "^8.57.0",
		"npm-package-json-lint": "^7.1.0",
		"npm-run-all": "^4.1.5",
		"postcss": "^8.4.38",
		"postcss-cli": "^11.0.0",
		"postcss-import": "^16.1.0",
		"postcss-preset-env": "^9.5.4",
		"prettier": "npm:wp-prettier@3.0.3",
		"resolve-bin": "^1.0.0",
		"rimraf": "^5.0.5",
		"source-map-loader": "^5.0.0",
		"stylelint": "^15.11.0",
		"thread-loader": "^4.0.2",
		"webpack": "^5.91.0",
		"webpack-bundle-analyzer": "^4.5.0",
		"webpack-cli": "^5.1.4"
	},
	"scripts": {
		"build": "NODE_ENV=production run-s clean test 'build:*'",
		"build:scripts": "webpack",
		"build:styles": "postcss 'src/*.css' --dir build/",
		"clean": "rimraf build/",
		"lint:scripts": "eslint '*.js' 'src/**/*.js'",
		"lint:styles": "stylelint 'src/**/*.css'",
		"lint:pkg": "npmPkgJsonLint .",
		"lint:php": "composer lint",
		"fix:scripts": "eslint --fix '*.js' 'src/**/*.js'",
		"fix:php": "composer format",
		"start": "run-p 'build:*'",
		"fix": "run-p 'fix:*'",
		"test": "run-p 'lint:*'"
	}
}
